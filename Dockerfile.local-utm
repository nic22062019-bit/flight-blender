# Local build of flight-blender for nick-hp.
# Overrides vs upstream Dockerfile (components/flight-blender/Dockerfile):
#  - chainguard bases (cgr.dev / geo-blocked) -> docker.io/library/python:3.14-slim
#    (uv.lock pins requires-python ==3.14.*)
#  - `uv` installed in the builder (the slim base ships no uv)
#  - `--mount=type=cache` removed (fails on the legacy builder)
#  - multi-source `COPY --from=builder ... a b c` split into separate lines
#  - `strip` / test-prune steps dropped (no binutils in slim, non-essential)
FROM docker.io/library/python:3.14-slim AS builder

ENV PIP_NO_CACHE_DIR=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0 \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

WORKDIR /app

COPY uv.lock pyproject.toml ./
RUN uv sync --frozen --no-dev --no-install-project

COPY LICENSE README.md ./
COPY src ./src
COPY alembic ./alembic
COPY alembic.ini ./
RUN uv sync --frozen --no-dev \
 && find /app/.venv -type d \( -name test -o -name tests \) -prune -exec rm -rf '{}' + \
 && find /app/.venv -type f \( -name '*.pyc' -o -name '*.pyo' \) -delete

FROM docker.io/library/python:3.14-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/venv/bin:${PATH}" \
    VIRTUAL_ENV="/venv" \
    DEBIAN_FRONTEND=noninteractive

# rtree/pyproj/shapely/cryptography are pulled in as manylinux wheels; the runtime only
# needs the shared libs they link against.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libgomp1 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/.venv /venv
COPY src ./src
COPY alembic ./alembic
COPY alembic.ini ./
COPY LICENSE ./
COPY README.md ./

EXPOSE 8000

ENTRYPOINT ["/venv/bin/python", "-m", "flight_blender.container_entrypoint"]
CMD ["serve"]